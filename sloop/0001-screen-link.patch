+/* fm1-ipad addition (not in SLOOP 2.8.4): the screen state, so an editor can follow and set the page.
+ *   90 UI       -> home (0/1), page (index into PAGES), layer (LY_*, 0 none), menu (0 off)
+ *                  also pushed whenever it changes, while WATCH was sent with bit 2 (4)
+ *   91 UI_GOTO  page -> opens that page as its family's button would (no reply for a page that is not
+ *                  shown); the reply is the state, as UI
+ * Stock editors never send bit 2 or these commands, so they see no difference. */
+#define ED_UI 90u
+#define ED_UI_GOTO 91u
+static uint8_t ed_ui_on, ed_ui_last[4];
+UI_SMALL static void ed_ui_state(void)
+{
+    ed_b(ui.home);
+    ed_b(ui.page);
+    ed_b(ui.layer);
+    ed_b(ui.menu);
+}
