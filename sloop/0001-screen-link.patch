+                return;
+            ed_ui_last[0] = s[0], ed_ui_last[1] = s[1], ed_ui_last[2] = s[2], ed_ui_last[3] = s[3];
+            ed_begin(ED_UI);
+            ed_ui_state();
+            ed_send();
+            n++;
+        }
+    }
     if (sync_reload || ed_eng(TSEL) != ed_w.eng || TSEL->preset != ed_w.preset || song.sel != ed_w.sel) {
