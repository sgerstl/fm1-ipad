{
  "version": 2,
  "note": "v2 (2026-11-05): the flat look, from vault Projects/Dev/fm1-ipad/skiff-arrange-spec.md. Flat and monochrome: colour only for track colours, knob rings and REC; elevation (a lighter surface, a soft shadow and a 2 pt ring) as the sign of selection. v1's physical surfaces are kept under `physical` while the two are compared (Settings \u203a Developer in debug builds). The app mirrors this in ios/FM1/Theme.swift.",
  "look": [
    "flat",
    "physical"
  ],
  "surface": {
    "page": "#0D0D0F",
    "well": "#111114",
    "panel": "#1A1A1E",
    "control": "#26262B",
    "lifted": "#34343B",
    "held": "#3E3E46",
    "pressed": "#141417",
    "stepEmpty": "#2A2A30",
    "stepOutside": "#18181C"
  },
  "chiclet": {
    "radiusPt": 8,
    "heightPt": 44,
    "edgePt": 2,
    "edge": "#0A0A0C",
    "pressedMs": 60,
    "releaseMs": 100,
    "primaryTop": "#EDEDF0",
    "primaryEdge": "#8A8A92",
    "disabledOutline": "#4A4A52",
    "note": "a flat top standing on a hard base edge drawn as an offset shape: no blur, no gradient, no highlight. Pressed (and a latched toggle when on) moves the top down onto the edge."
  },
  "elevation": {
    "0": {
      "use": "everything at rest",
      "surface": "page / well / control",
      "shadow": null
    },
    "1": {
      "use": "panels that group: the inspector, side bins, sheets",
      "surface": "panel",
      "shadow": {
        "y": 6,
        "blur": 16,
        "opacity": 0.35
      }
    },
    "2": {
      "use": "the selected thing: a block, the selected track's chip, the active tab",
      "surface": "lifted",
      "shadow": {
        "y": 4,
        "blur": 12,
        "opacity": 0.45
      },
      "ringPt": 2,
      "ring": "text.primary"
    },
    "3": {
      "use": "a dragged thing, menus and popovers",
      "surface": "held",
      "shadow": {
        "y": 12,
        "blur": 28,
        "opacity": 0.6
      },
      "scale": 1.03
    },
    "intensity": {
      "quiet": {
        "shadow": 0.6,
        "toneStep": -1
      },
      "medium": {
        "shadow": 1.0,
        "toneStep": 0
      },
      "strong": {
        "shadow": 1.4,
        "toneStep": 1
      },
      "tones": [
        "#26262B",
        "#2D2D33",
        "#34343B",
        "#3E3E46",
        "#48484F"
      ],
      "note": "toneStep moves lifted and held one tone down or up this ladder"
    },
    "motion": {
      "liftMs": 150,
      "dropMs": 120,
      "reduceMotion": "instant, no scale"
    }
  },
  "physical": {
    "version": 1,
    "surface": {
      "page": "#0D0D0F",
      "panelTop": "#212126",
      "panelBottom": "#1A1A1E",
      "well": "#111114",
      "raisedTop": "#3A3A42",
      "raisedBottom": "#2D2D33",
      "stepEmpty": "#2A2A30",
      "stepOutside": "#18181C",
      "pressed": "#1E1E23"
    },
    "note": "v1, kept for comparison: gradients, inner shadows and raised keys"
  },
  "text": {
    "primary": "#EDEDF0",
    "secondary": "#A1A1AA",
    "tertiary": "#71717A",
    "onColour": "#101012"
  },
  "track": [
    {
      "n": 1,
      "color": "#287CFF",
      "top": "#4A93FF"
    },
    {
      "n": 2,
      "color": "#1ECC70",
      "top": "#4ADB8C"
    },
    {
      "n": 3,
      "color": "#FFC618",
      "top": "#FFD54D"
    },
    {
      "n": 4,
      "color": "#FF621A",
      "top": "#FF8247",
      "note": "drums"
    }
  ],
  "label": {
    "maxChars": 8,
    "vocabulary": [
      "NOTE",
      "VELOCITY",
      "GATE",
      "PROB",
      "CHORD",
      "TIE",
      "LENGTH",
      "BLOCK",
      "TRACK",
      "ATTACK",
      "DECAY",
      "SUSTAIN",
      "RELEASE",
      "RATE",
      "DEPTH",
      "CUTOFF",
      "REVERB",
      "DELAY",
      "VOLUME",
      "PAN"
    ]
  },
  "step": {
    "selectedRingPx": 2,
    "widthPt": 38,
    "rowPt": 46
  },
  "knob": [
    "#287CFF",
    "#1ECC70",
    "#FFC618",
    "#FF2C34"
  ],
  "arrange": {
    "blockTones": [
      "#2E2E35",
      "#3A3A42",
      "#46464F",
      "#52525C"
    ],
    "restOutline": "#4A4A52",
    "linkRing": "#A1A1AA",
    "note": "Skiff's Arrange: each block in its track's colour with onColour text (Scott, 2026-11-05: solid, over tinted and the spec's greys); the selected block lifts with the 2 pt ring outside it, on the lane; linked copies get a dark dashed ring; rests are dashed grey outlines; blockTones only for a pattern no single track names"
  }
}
